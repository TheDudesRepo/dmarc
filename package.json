{
  "name": "cresswell-security-lab",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:container",
    "test:unit": "vitest run",
    "test:container": "npm --prefix scanner-container test",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs",
    "test:watch": "vitest",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^29.1.1",
    "miniflare": "5.20260801.1-alpha",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "workerd": "1.20260811.1",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "workerd": "1.20260811.1"
  }
}
